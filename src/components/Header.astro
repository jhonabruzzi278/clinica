---
// Simple and clean header - no distractions, immediate content delivery
---

<header class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-10" role="banner">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 hover:opacity-80 transition-opacity focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 rounded-lg p-1" aria-label="Linda Sonrisa - Clínica Dental">
  <img src="/icono.png" alt="Logo Linda Sonrisa" class="h-16 w-16" />
        <div>
          <span class="text-xl font-bold text-teal-700">Linda Sonrisa</span>
          <p class="text-xs text-gray-500 -mt-1 hidden sm:block">Clínica Dental</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8" role="navigation" aria-label="Navegación principal">
        <a href="/" class="text-gray-700 hover:text-teal-600 font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 rounded px-2 py-1">
          Inicio
        </a>
        <a href="/#especialidades" class="text-gray-700 hover:text-teal-600 font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 rounded px-2 py-1">
          Servicios
        </a>
        <a href="/#testimonios" class="text-gray-700 hover:text-teal-600 font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 rounded px-2 py-1">
          Testimonios
        </a>
        <a href="/contacto" class="text-gray-700 hover:text-teal-600 font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 rounded px-2 py-1">
          Contacto
        </a>
      </nav>

      <!-- CTA Button -->
      <a 
        href="/contacto" 
        class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-2 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2"
        aria-label="Agendar cita dental"
      >
        <span class="hidden sm:inline">Agendar Cita</span>
        <span class="sm:hidden">Cita</span>
      </a>

      <!-- Mobile menu button -->
      <button 
        type="button" 
        class="md:hidden ml-4 p-2 rounded-lg text-gray-500 hover:text-teal-600 hover:bg-teal-50 focus:outline-none focus:ring-2 focus:ring-teal-500 transition-all duration-300" 
        aria-controls="mobile-menu" 
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
        id="mobile-menu-button"
      >
        <svg class="w-6 h-6 transform transition-transform duration-300" id="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path class="menu-top transition-all duration-300" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16"></path>
          <path class="menu-middle transition-all duration-300" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16"></path>
          <path class="menu-bottom transition-all duration-300" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div class="md:hidden hidden overflow-hidden transition-all duration-300 ease-in-out" id="mobile-menu">
      <nav class="px-4 pt-4 pb-6 space-y-2 bg-gradient-to-b from-gray-50 to-white border-t border-gray-100 shadow-inner" role="navigation" aria-label="Navegación móvil">
        <a href="/" class="flex items-center px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-all duration-200 font-medium">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          Inicio
        </a>
        <a href="/#especialidades" class="flex items-center px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-all duration-200 font-medium">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          Servicios
        </a>
        <a href="/#testimonios" class="flex items-center px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-all duration-200 font-medium">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path>
          </svg>
          Testimonios
        </a>
        <a href="/contacto" class="flex items-center px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-all duration-200 font-medium">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          Contacto
        </a>
        <div class="pt-4 mt-4 border-t border-gray-200">
          <a 
            href="/contacto" 
            class="flex items-center justify-center w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg"
            aria-label="Agendar cita dental"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Agendar Cita
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
// Mobile menu toggle with animated hamburger icon
document.addEventListener('DOMContentLoaded', function() {
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuTop = document.querySelector('.menu-top');
  const menuMiddle = document.querySelector('.menu-middle');
  const menuBottom = document.querySelector('.menu-bottom');
  const menuIcon = document.getElementById('menu-icon');
  
  if (button && menu) {
    button.addEventListener('click', function() {
      const isOpen = !menu.classList.contains('hidden');
      
      if (isOpen) {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        // Reset icon to hamburger
        menuTop.classList.remove('rotate-45', 'translate-y-[10px]');
        menuMiddle.classList.remove('opacity-0');
        menuBottom.classList.remove('-rotate-45', '-translate-y-[10px]');
        menuIcon.classList.remove('rotate-180');
      } else {
        menu.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
        // Transform to X
        menuTop.classList.add('rotate-45', 'translate-y-[10px]');
        menuMiddle.classList.add('opacity-0');
        menuBottom.classList.add('-rotate-45', '-translate-y-[10px]');
        menuIcon.classList.add('rotate-180');
      }
    });
    
    // Close menu when clicking on a link
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', function() {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        // Reset icon
        menuTop.classList.remove('rotate-45', 'translate-y-[10px]');
        menuMiddle.classList.remove('opacity-0');
        menuBottom.classList.remove('-rotate-45', '-translate-y-[10px]');
        menuIcon.classList.remove('rotate-180');
      });
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', function(e) {
      if (!button.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        // Reset icon
        menuTop.classList.remove('rotate-45', 'translate-y-[10px]');
        menuMiddle.classList.remove('opacity-0');
        menuBottom.classList.remove('-rotate-45', '-translate-y-[10px]');
        menuIcon.classList.remove('rotate-180');
      }
    });
  }
});
</script>

